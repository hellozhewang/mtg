<!-- @SEARCH@ -->
<Panel id="czs_panel_{C}" visibility="{C}" active="False" width="480" height="94%"
       rectAlignment="MiddleRight" offsetXY="-16 0" allowDragging="true" returnToOriginalPositionWhenReleased="false"
       color="#090909" outline="#181818" outlineSize="1 1">
  <Text id="czs_title_{C}" width="400" height="32" rectAlignment="UpperLeft" offsetXY="12 -10"
        fontSize="20" color="#E2E5EA" alignment="MiddleLeft" text="Inspect"/>
  <Button onClick="czsClose" width="28" height="28" rectAlignment="UpperRight" offsetXY="-12 -10"
          fontSize="20" color="#FFFFFF" textColor="#E27373" colors="#242424|#484040|#282020|#242424" text="×"/>
  <InputField id="czs_query_{C}" width="406" height="34" rectAlignment="UpperLeft" offsetXY="12 -50"
              fontSize="16" onValueChanged="czsSearch" color="#101010"
              colors="#FFFFFF|#FFFFFF|#FFFFFF|#8C9AAD" textColor="#E2E5EA"
              caretColor="#C0C8D2" placeholder="Search all card text…"/>
  <Button id="czs_regex_{C}" onClick="czsToggleRegex" width="44" height="34" rectAlignment="UpperRight" offsetXY="-12 -50"
          fontSize="18" color="#FFFFFF" textColor="#E2E5EA" colors="#242424|#383838|#181818|#242424" text=".*"
          tooltip="Regex off. Click to enable: creature|artifact, draw.*card, or \belf\b. Searches all stored card text."/>
  <Panel anchorMin="0 0" anchorMax="1 1" offsetMin="12 28" offsetMax="-12 -92" color="#020202">
    <VerticalScrollView id="czs_scroll_{C}" width="100%" height="100%" color="#020202" movementType="Clamped" scrollSensitivity="28"
                        verticalScrollbarVisibility="AutoHide" scrollbarBackgroundColor="#222222"
                        scrollbarColors="#666666|#888888|#999999|#444444">
      <GridLayout id="czs_grid_{C}" cellSize="104 126" spacing="6 8" padding="4 12 4 4"
                  constraint="FixedColumnCount" constraintCount="4" childAlignment="UpperLeft"
                  rectAlignment="UpperLeft" pivot="0 1" height="0" preferredHeight="0">
@CARDS@
      </GridLayout>
    </VerticalScrollView>
    <Text id="czs_empty_{C}" active="False" fontSize="15" color="#C0C8D2" text="No matching objects." raycastTarget="false"/>
  </Panel>
  <Text id="czs_count_{C}" width="440" height="16" rectAlignment="LowerLeft" offsetXY="12 8"
        fontSize="11" color="#C0C8D2" alignment="MiddleLeft" text=""/>
  <!-- Outside the scrolling viewport; never intercept pointer events or cover the hovered cell. -->
  <Panel id="czs_zoom_{C}" active="False" width="380" height="570" rectAlignment="MiddleRight" offsetXY="-492 0"
         color="#090909" outline="#181818" outlineSize="1 1" raycastTarget="false">
    <Text id="czs_zoom_name_{C}" width="356" height="28" rectAlignment="UpperCenter" offsetXY="0 -8"
          fontSize="14" color="#E2E5EA" text="" raycastTarget="false"/>
    <Image id="czs_zoom_image_{C}" width="356" height="520" rectAlignment="UpperCenter" offsetXY="0 -40"
           preserveAspect="true" color="#FFFFFF00" raycastTarget="false"/>
  </Panel>
  <!-- Click preview stays beside Inspect too, leaving its search field and card grid usable. -->
  <Panel id="czs_preview_{C}" active="False" width="344" height="540" rectAlignment="MiddleRight" offsetXY="-492 0"
         color="#090909" outline="#181818" outlineSize="1 1">
    <VerticalLayout padding="12 12 12 12" spacing="8" childForceExpandHeight="false">
      <Text id="czs_preview_name_{C}" preferredHeight="36" fontSize="15" color="#E2E5EA" horizontalOverflow="Wrap" text=""/>
      <Image id="czs_preview_image_{C}" preferredHeight="424" preserveAspect="true" color="#FFFFFF00"/>
      <HorizontalLayout preferredHeight="32" spacing="8">
        <Button onClick="czsHidePreview" color="#FFFFFF" colors="#444444|#555555|#333333|#222222" textColor="#E2E5EA" text="Back"/>
        <Button id="czs_preview_take_{C}" onClick="czsTake" color="#FFFFFF" colors="#305448|#3A6456|#244036|#222222" textColor="#E2E5EA" text="Take to hand"/>
      </HorizontalLayout>
      <Text id="czs_status_{C}" preferredHeight="16" fontSize="11" color="#C0C8D2" text=""/>
    </VerticalLayout>
  </Panel>
</Panel>
<!-- @CARD@ -->
          <Button id="czs_card_{I}_{C}" onClick="czsPick" onMouseEnter="czsHover" onMouseExit="czsUnhover" active="False" color="#FFFFFF" text=""
                  colors="#010101|#101010|#181818|#010101">
            <Image id="czs_image_{I}_{C}" width="96" height="96" rectAlignment="UpperCenter" offsetXY="0 -4"
                   preserveAspect="true" color="#FFFFFF00" raycastTarget="false"/>
            <Text id="czs_name_{I}_{C}" width="96" height="20" rectAlignment="LowerCenter" offsetXY="0 4"
                  fontSize="12" resizeTextForBestFit="true" resizeTextMinSize="10" resizeTextMaxSize="12" color="#E2E5EA" text="" raycastTarget="false"/>
          </Button>

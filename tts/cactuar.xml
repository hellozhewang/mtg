<!-- Cactuar browser. All dynamic text is an attribute, so the table's importer
     can safely rebuild the shared UI. No global Defaults: the base owns those. -->
<!-- @PANEL@ -->
<Panel id="cz_panel_{C}" visibility="{C}" active="False"
       width="1280" height="864" rectAlignment="MiddleRight" offsetXY="-24 0"
       allowDragging="true" returnToOriginalPositionWhenReleased="false"
       color="#111923FC" outline="#34465B" outlineSize="1 1"
       shadow="#00000080" shadowDistance="-4 -6">
  <VerticalLayout padding="16 16 16 16" spacing="8" childForceExpandHeight="false" childForceExpandWidth="true">
    <HorizontalLayout preferredHeight="36" spacing="8" childForceExpandWidth="false">
      <Text flexibleWidth="1" fontSize="24" fontStyle="Bold" color="#E6E9EE" alignment="MiddleLeft" text="Cactuar decks"/>
      <Button id="cz_tour_{C}" onClick="czTournament" preferredWidth="130" fontSize="13" color="#FFFFFF"
              colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Tournament"/>
      <Button id="cz_refresh_{C}" onClick="czRefresh" preferredWidth="94" fontSize="13" color="#FFFFFF"
              colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Refresh"/>
      <Button id="cz_close_{C}" onClick="czClose" preferredWidth="36" fontSize="18" color="#FFFFFF"
              colors="#243244|#643B46|#482C35|#1B2533" textColor="#E2E5EA" text="×"/>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="36" spacing="8" childForceExpandWidth="false">
      <InputField id="cz_search_{C}" flexibleWidth="1" fontSize="15" onValueChanged="czSearch"
                  color="#1D2A3A" colors="#FFFFFF|#FFFFFF|#FFFFFF|#8C9AAD"
                  textColor="#E2E5EA" caretColor="#3D6554" selectionColor="#345E63"
                  placeholder="Search decks, commanders, owners or strategies"/>
      <Button id="cz_reset_{C}" onClick="czClear" preferredWidth="78" fontSize="13" color="#FFFFFF"
              colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Reset"/>
    </HorizontalLayout>
    <HorizontalLayout id="cz_filters_{C}" preferredHeight="34" spacing="6">
      <Button id="cz_f_bracket_{C}" onClick="czFilter(bracket)" fontSize="13" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Bracket: All ▾"/>
      <Button id="cz_f_tier_{C}" onClick="czFilter(tier)" fontSize="13" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Tier: All ▾"/>
      <Button id="cz_f_theme_{C}" onClick="czFilter(theme)" fontSize="12" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Strategy: All ▾"/>
      <Button id="cz_f_owner_{C}" onClick="czFilter(owner)" fontSize="13" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Owner: All ▾"/>
    </HorizontalLayout>
    <!-- Tournament mode replaces the filter row with its modes. -->
    <HorizontalLayout id="cz_tourbar_{C}" preferredHeight="34" spacing="6" active="False">
      <Button id="cz_tmode_all_{C}" onClick="czTourMode(all)" fontSize="13" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="All pick"/>
      <Button id="cz_tmode_draft_{C}" onClick="czTourMode(draft)" fontSize="13" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Draft"/>
      <Button id="cz_tmode_random_{C}" onClick="czTourMode(random)" fontSize="13" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Random"/>
      <Button id="cz_tredraw_{C}" onClick="czTourRedraw" fontSize="13" active="False" color="#FFFFFF" colors="#3B2F24|#5A4530|#2C2219|#1B2533" textColor="#E2E5EA" text="Reroll"/>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="28" spacing="4" childForceExpandWidth="false">
      <Text preferredWidth="32" fontSize="12" color="#C0C8D2" alignment="MiddleLeft" text="Sort"/>
      <Button id="cz_sort_tier_{C}" onClick="czSort(tier)" preferredWidth="66" fontSize="12" color="#FFFFFF" textColor="#E2E5EA" text="Tier"/>
      <Button id="cz_sort_name_{C}" onClick="czSort(name)" preferredWidth="66" fontSize="12" color="#FFFFFF" textColor="#E2E5EA" text="Name"/>
      <Button id="cz_sort_newest_{C}" onClick="czSort(newest)" preferredWidth="70" fontSize="12" color="#FFFFFF" textColor="#E2E5EA" text="Newest"/>
      <Text id="cz_count_{C}" flexibleWidth="1" fontSize="12" color="#C0C8D2" alignment="MiddleRight" text="Loading collection…"/>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="630" spacing="12" childForceExpandWidth="false">
      <Panel flexibleWidth="1" color="#111923">
      <VerticalLayout id="cz_deck_list_{C}" width="100%" height="100%" spacing="8" childForceExpandHeight="false">
        <Panel preferredHeight="588" color="#111923">
          <VerticalLayout spacing="3" childForceExpandHeight="false">
@ROWS@
          </VerticalLayout>
          <Text id="cz_empty_{C}" active="False" fontSize="16" color="#C0C8D2" alignment="MiddleCenter"
                text="No matching decks.&#10;&#10;Try another search or reset the filters." raycastTarget="false"/>
        </Panel>
        <HorizontalLayout preferredHeight="34" spacing="6" childForceExpandWidth="false">
          <Button id="cz_prev_{C}" onClick="czPage(prev)" preferredWidth="34" fontSize="20" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="‹"/>
          <Text id="cz_page_{C}" flexibleWidth="1" fontSize="12" color="#C0C8D2" alignment="MiddleCenter" text="Page 1 / 1"/>
          <Button id="cz_next_{C}" onClick="czPage(next)" preferredWidth="34" fontSize="20" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="›"/>
          <Button id="cz_random_{C}" onClick="czRandom" preferredWidth="98" fontSize="12" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Surprise me"/>
        </HorizontalLayout>
      </VerticalLayout>
      <Panel id="cz_guide_view_{C}" width="100%" height="100%" active="False" color="#162130">
        <Text id="cz_guide_title_{C}" width="400" height="36" rectAlignment="UpperLeft" offsetXY="12 -8"
              fontSize="18" color="#E2E5EA" alignment="MiddleLeft" text="Deck guide"/>
        <Button id="cz_guide_back_{C}" onClick="czGuideClose" width="114" height="32" rectAlignment="UpperRight" offsetXY="-12 -10"
                fontSize="13" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Back to decks"/>
        <Panel anchorMin="0 0" anchorMax="1 1" offsetMin="12 12" offsetMax="-12 -54" color="#162130">
          <VerticalScrollView id="cz_guide_scroll_{C}" width="100%" height="100%" color="#162130"
                              movementType="Clamped" scrollSensitivity="32" verticalScrollbarVisibility="AutoHide"
                              scrollbarBackgroundColor="#243244" scrollbarColors="#65788C|#8192A3|#65788C|#243244">
            <VerticalLayout id="cz_guide_content_{C}" height="100" preferredHeight="100" spacing="10"
                            childForceExpandHeight="false" childForceExpandWidth="true">
              <Text id="cz_guide_text_{C}" preferredHeight="80" fontSize="16" color="#E2E5EA"
                    alignment="UpperLeft" horizontalOverflow="Wrap" text=""/>
            </VerticalLayout>
          </VerticalScrollView>
        </Panel>
      </Panel>
      </Panel>
      <Panel minWidth="650" preferredWidth="650" flexibleWidth="0" color="#1A2635">
        <HorizontalLayout padding="12 12 12 12" spacing="12" childForceExpandWidth="false">
        <VerticalLayout minWidth="190" preferredWidth="190" flexibleWidth="0" spacing="8" childForceExpandHeight="false">
          <Text preferredHeight="12" fontSize="11" fontStyle="Bold" color="#3D6554" alignment="MiddleLeft" text="DECK DETAILS"/>
          <Text id="cz_detail_{C}" flexibleHeight="1" fontSize="14" color="#E2E5EA" alignment="UpperLeft"
                horizontalOverflow="Wrap" text="Select a deck to see its commander, strategy and stats."/>
          <HorizontalLayout id="cz_stats_{C}" preferredHeight="40" spacing="4" active="False">
            <Text id="cz_gc_{C}" fontSize="12" color="#E2E5EA" text=""/>
            <Text id="cz_mv_{C}" fontSize="12" color="#E2E5EA" text=""/>
            <Text id="cz_lands_{C}" fontSize="12" color="#E2E5EA" text=""/>
          </HorizontalLayout>
          <Text id="cz_dates_{C}" preferredHeight="26" fontSize="11" color="#C0C8D2" alignment="UpperLeft" text=""/>
          <Button id="cz_sleeve_{C}" onClick="czFilter(sleeve)" preferredHeight="30" fontSize="12" interactable="False"
                  color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Sleeves: Standard ▾"/>
          <Button id="cz_guide_{C}" onClick="czGuide" preferredHeight="36" fontSize="14" interactable="False"
                  color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Guide"/>
          <Button id="cz_load_{C}" onClick="czLoad" preferredHeight="40" fontSize="15" fontStyle="Bold" interactable="False"
                  color="#FFFFFF" colors="#173B30|#1A3F32|#123127|#202C39" textColor="#E2E5EA" text="Select a deck"/>
        </VerticalLayout>
        <VerticalLayout minWidth="424" preferredWidth="424" flexibleWidth="0" spacing="8" childForceExpandHeight="false">
          <Text id="cz_commander_name_{C}" preferredHeight="36" fontSize="15" color="#E2E5EA" alignment="MiddleCenter"
                horizontalOverflow="Wrap" text="Commander preview"/>
          <Panel minHeight="520" preferredHeight="520" flexibleHeight="0" color="#111923">
            <Image id="cz_commander_image_{C}" width="85%" height="85%" rectAlignment="MiddleCenter" preserveAspect="true" color="#FFFFFF00" raycastTarget="false"/>
            <Button id="cz_commander_show_{C}" onClick="czCommanderShow" width="232" height="40" rectAlignment="MiddleCenter"
                    fontSize="15" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA"
                    text="Load commander image" active="False"/>
            <Text id="cz_commander_note_{C}" fontSize="16" color="#C0C8D2" alignment="MiddleCenter" rectAlignment="MiddleCenter" offsetXY="0 -60" height="80" width="95%"
                  text="Select a deck to read its commander." raycastTarget="false"/>
          </Panel>
          <HorizontalLayout minHeight="34" preferredHeight="34" flexibleHeight="0" spacing="6" childForceExpandWidth="false">
            <Button id="cz_commander_prev_{C}" onClick="czCommander(prev)" preferredWidth="34" fontSize="20" color="#FFFFFF"
                    colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="‹" interactable="False"/>
            <Text id="cz_commander_page_{C}" flexibleWidth="1" fontSize="12" color="#C0C8D2" text=""/>
            <Button id="cz_commander_flip_{C}" onClick="czCommander(flip)" preferredWidth="60" fontSize="13" color="#FFFFFF"
                    colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="Flip" active="False"/>
            <Button id="cz_commander_next_{C}" onClick="czCommander(next)" preferredWidth="34" fontSize="20" color="#FFFFFF"
                    colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="›" interactable="False"/>
          </HorizontalLayout>
        </VerticalLayout>
        </HorizontalLayout>
      </Panel>
    </HorizontalLayout>
    <Text id="cz_status_{C}" preferredHeight="20" fontSize="12" color="#C0C8D2" alignment="MiddleLeft" text=""/>
  </VerticalLayout>
  <!-- The dismiss target and menu overlay the main layout. -->
  <Button id="cz_scrim_{C}" active="False" onClick="czDismiss" color="#00000055" transition="None" text=""/>
  <Panel id="cz_menu_{C}" active="False" width="244" height="350" rectAlignment="UpperLeft" offsetXY="16 -146"
         color="#202F42" outline="#49627C" outlineSize="1 1" shadow="#00000090" shadowDistance="3 -4">
    <VerticalLayout padding="10 10 10 10" spacing="3" childForceExpandHeight="false">
      <Text id="cz_menu_title_{C}" preferredHeight="30" fontSize="12" fontStyle="Bold" color="#C0C8D2" alignment="MiddleLeft" text="Choose a filter"/>
@CHOICES@
      <HorizontalLayout id="cz_menu_pager_{C}" preferredHeight="28" active="False" spacing="6" childForceExpandWidth="false">
        <Button id="cz_menu_prev_{C}" onClick="czMenuPage(prev)" preferredWidth="32" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="‹"/>
        <Text id="cz_menu_page_{C}" flexibleWidth="1" fontSize="12" color="#C0C8D2" text=""/>
        <Button id="cz_menu_next_{C}" onClick="czMenuPage(next)" preferredWidth="32" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="›"/>
      </HorizontalLayout>
    </VerticalLayout>
  </Panel>
  <!-- Sleeves: a paged grid of thumbnails, opened from the Sleeves button. -->
  <Panel id="cz_sleeves_{C}" active="False" width="372" height="330" rectAlignment="UpperRight" offsetXY="-16 -146"
         color="#202F42" outline="#49627C" outlineSize="1 1" shadow="#00000090" shadowDistance="3 -4">
    <VerticalLayout padding="10 10 10 10" spacing="6" childForceExpandHeight="false">
      <Text id="cz_sleeves_title_{C}" preferredHeight="22" fontSize="12" fontStyle="Bold" color="#C0C8D2" alignment="MiddleLeft" text="Choose sleeves"/>
      <GridLayout preferredHeight="250" cellSize="82 122" spacing="6 6" constraint="FixedColumnCount" constraintCount="4" childAlignment="UpperLeft">
@SLEEVECELLS@
      </GridLayout>
      <HorizontalLayout id="cz_sleeves_pager_{C}" preferredHeight="28" active="False" spacing="6" childForceExpandWidth="false">
        <Button id="cz_sleeves_prev_{C}" onClick="czMenuPage(prev)" preferredWidth="32" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="‹"/>
        <Text id="cz_sleeves_page_{C}" flexibleWidth="1" fontSize="12" color="#C0C8D2" text=""/>
        <Button id="cz_sleeves_next_{C}" onClick="czMenuPage(next)" preferredWidth="32" color="#FFFFFF" colors="#243244|#34485F|#1C2938|#1B2533" textColor="#E2E5EA" text="›"/>
      </HorizontalLayout>
    </VerticalLayout>
  </Panel>
</Panel>
<!-- @ROW@ -->
            <Button id="cz_row_{I}_{C}" onClick="czPick({I})" preferredHeight="55" active="False" color="#FFFFFF"
                    colors="#1C2939|#2D4157|#244E46|#182331" text="">
              <HorizontalLayout padding="6 10 6 6" spacing="8" childForceExpandWidth="false" raycastTarget="false">
                <Text id="cz_row_tier_{I}_{C}" preferredWidth="42" fontSize="12" fontStyle="Bold" color="#E2E5EA" text="" raycastTarget="false"/>
                <VerticalLayout flexibleWidth="1" spacing="0" childForceExpandHeight="false" raycastTarget="false">
                  <Text id="cz_row_name_{I}_{C}" preferredHeight="22" fontSize="16" fontStyle="Normal" color="#E2E5EA" alignment="MiddleLeft" text="" raycastTarget="false"/>
                  <Text id="cz_row_sub_{I}_{C}" preferredHeight="20" fontSize="13" color="#CDD3DC" alignment="MiddleLeft" text="" raycastTarget="false"/>
                </VerticalLayout>
              </HorizontalLayout>
            </Button>
<!-- @CHOICE@ -->
      <Button id="cz_choice_{I}_{C}" onClick="czChoose({I})" preferredHeight="30" fontSize="13" textAlignment="MiddleLeft"
              padding="8 8 0 0" color="#FFFFFF" colors="#202F42|#344D66|#275B4B|#182331" textColor="#E2E5EA" text="" active="False"/>
<!-- @SLEEVECELL@ -->
        <Button id="cz_sl_{I}_{C}" onClick="czSleevePick({I})" active="False" color="#FFFFFF"
                colors="#202F42|#344D66|#275B4B|#182331" text="">
          <VerticalLayout padding="4 4 4 2" spacing="2" childForceExpandHeight="false" raycastTarget="false">
            <Image id="cz_sl_img_{I}_{C}" preferredHeight="96" preserveAspect="true" color="#FFFFFF00" raycastTarget="false"/>
            <Text id="cz_sl_name_{I}_{C}" preferredHeight="14" fontSize="10" color="#E2E5EA" text="" raycastTarget="false"/>
          </VerticalLayout>
        </Button>

# Generated Scryfall/EDHREC cache. 12 MB, rebuilds itself on demand — the tools
# refetch anything missing, so committing it only adds churn.
.cache/

# Request and tool-usage logs. Machine-local history, not source.
logs/

# Pinned Codex session UUIDs, one per Discord channel. Machine-local state, and
# a session id from one machine is meaningless on another.
bot/.sessions/
bot/.session.json

# Empty SQLite file used only as a cross-process mutex for autopush. Holds no
# data — it exists so BEGIN IMMEDIATE has something to lock.
bot/.locks.db

# Transient reply files bot.py writes for `codex -o` and cleans up after.
bot/.reply-*.txt

# Only created on the npm-shim fallback path; a symlink to a local node install.
bot/.sandbox-bin/
# The agy harness's own home: settings, conversations and a copy of the sign-in.
bot/.harness/
bot/.sleever/

# GENERATED — the source of truth is AGENTS_MD in scripts/build_agents.py, and
# this copy is overwritten before every message. Committing it would invite
# editing the wrong one.
public/*/AGENTS.md

# Internal notes, deliberately NOT published. Implementation detail, the measured
# sandbox boundary, and known security gaps including machine-local absolute
# paths — useful to whoever runs this, not to whoever reads the repo.
INTERNALS.md
todo/

__pycache__/
*.pyc
.DS_Store

# Whole-bot mutex. Empty SQLite file; the lock IS the open transaction. The glob
# matters: SQLite also writes `-journal`/`-wal` siblings, and a pattern without it
# let `.busy.db-journal` get committed once.
bot/.busy.db*
bot/.locks.db*

# Retired: who requested each deck, from before decks lived in owner folders
# (public/<user>/ is the owner now). Kept on disk for the record, never read.
bot/.deck-metadata.db*

# The owner's personal tools (cardsearch/, showcards/) and scratch files. Decks
# never live here: every deck is under public/<user>/, and private/ held the
# owner's decks only until 2026-10-18.
/private/

# The owner's copy of the catalog index, with local-only categories (Goblins).
# build_site.py writes it beside the published index; start_private_server.py
# serves it as the LAN catalog's home page. Ignored so Pages never serves it.
/docs/index.local.html

# VS Code workspace settings, which are machine-local and not source.
.vscode/
tests/.sandbox-probe/

tts/deploy.local.json
